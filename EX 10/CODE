#include <stdio.h>
#include <string.h>

int main()
{
    char gram[50], part1[50], part2[50];
    char modifiedGram[50], newGram[50];
    int i, j = 0, k = 0, pos;

    printf("Enter Production: S->");
    fgets(gram, sizeof(gram), stdin);

    gram[strcspn(gram, "\n")] = '\0';

    /* Extract first two alternatives */
    for(i = 0; gram[i] != '|' && gram[i] != '\0'; i++, j++)
        part1[j] = gram[i];

    part1[j] = '\0';

    if(gram[i] == '|')
        i++;

    for(j = 0; gram[i] != '\0'; i++, j++)
        part2[j] = gram[i];

    part2[j] = '\0';

    /* Find common prefix */
    for(i = 0; part1[i] == part2[i] && part1[i] != '\0'; i++)
    {
        modifiedGram[k++] = part1[i];
    }

    pos = i;

    /* Create modified production */
    modifiedGram[k++] = 'X';
    modifiedGram[k] = '\0';

    /* Create new production */
    j = 0;

    for(i = pos; part1[i] != '\0'; i++)
        newGram[j++] = part1[i];

    newGram[j++] = '|';

    for(i = pos; part2[i] != '\0'; i++)
        newGram[j++] = part2[i];

    newGram[j] = '\0';

    printf("\nS->%s", modifiedGram);
    printf("\nX->%s\n", newGram);

    return 0;
}
