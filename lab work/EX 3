#include <stdio.h>
#include <string.h>
#include <ctype.h>

int isKeyword(char buffer[])
{
    char keywords[32][10] =
    {
        "main", "auto", "break", "case", "char", "const",
        "continue", "default", "do", "double", "else",
        "enum", "extern", "float", "for", "goto", "if",
        "int", "long", "register", "return", "short",
        "signed", "sizeof", "static", "struct", "switch",
        "typedef", "unsigned", "void", "printf", "while"
    };

    int i;

    for (i = 0; i < 32; i++)
    {
        if (strcmp(keywords[i], buffer) == 0)
            return 1;
    }

    return 0;
}

int main()
{
    char input[200];
    char buffer[50];
    char operators[] = "+-*/%=";
    int i, j = 0;

    printf("Enter the C statement:\n");
    fgets(input, sizeof(input), stdin);

    for (i = 0; i <= strlen(input); i++)
    {
        if (isalnum(input[i]))
        {
            buffer[j++] = input[i];
        }
        else
        {
            if (j != 0)
            {
                buffer[j] = '\0';
                j = 0;

                if (isKeyword(buffer))
                    printf("%s is keyword\n", buffer);
                else
                    printf("%s is identifier\n", buffer);
            }

            if (strchr(operators, input[i]) != NULL)
            {
                printf("%c is operator\n", input[i]);
            }
        }
    }

    return 0;
}

